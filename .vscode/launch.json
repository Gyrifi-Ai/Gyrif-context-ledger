{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Gyrifi: Start local stack",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "docker compose up --build --remove-orphans"
    },
    {
      "name": "Gyrifi: Start development stack",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "docker compose -f compose.dev.yaml up --build --remove-orphans"
    }
  ]
}
